<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		VolumeArc iOS app (com.mabryventures.VolumeArc) privacy manifest.
		VOL-73: required-reason API coverage + collected data types.

		Required-reason APIs declared below cover first-party code only.
		Bundled frameworks (Sentry) ship their own PrivacyInfo.xcprivacy
		inside the XCFramework; Apple merges those at submission time, so
		we intentionally do NOT redeclare Sentry's SystemBootTime /
		FileTimestamp reasons here.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
			UserDefaults: telemetry rolling buffer (UserDefaultsTelemetrySink),
			watch connectivity state, feature flags, runtime flags, onboarding
			progress, outbound queue backfill markers, AI relay device ID
			fallback. All first-party app-functionality reads/writes.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!--
			HealthKit data: workouts, heart rate, active energy, HRV,
			sleep stages. Read and written only to deliver personalized
			coaching and keep the user's Apple Health training history
			accurate. VOL-209 disclosure normalization: RAW HealthKit
			samples are never sent off-device by VolumeArc — they stay
			in Apple Health (the HealthKit sandbox boundary). However,
			COMPUTED AGGREGATES derived from those samples (e.g.
			"7d HRV mean", "last-night sleep duration", "7d strength
			load") are embedded into the rendered coach prompt and
			transmitted to the AI relay (`relay.volumearc.app`) and
			Gemini when the user asks the coach a question. The
			NSPrivacyCollectedDataType_HealthAndFitness declaration
			below covers that egress. See `docs/SECURITY.md` threat
			model and `marketing/src/app/(main)/privacy/page.tsx`
			user-facing copy for the full disclosure.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeHealthAndFitness</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
			Audio (microphone) data: voice coaching requests and voice
			workout notes. Captured on-device via AVAudioApplication and
			processed via SFSpeechRecognizer. App functionality only.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeAudioData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!--
			User content: coach-memory entries (free-form text the user
			supplies to personalize coaching cues) and workout notes.
			Stored locally in SwiftData and synced via the user's private
			CloudKit database (NSPrivacyCollectedDataTypeLinked = false
			because VolumeArc has no user-identifying server-side account
			system; CloudKit binds the data to the device iCloud identity,
			not to a VolumeArc-owned account).
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
