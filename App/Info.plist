<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  VOL-56 (PR #24): Minimal base Info.plist for the app target. Only
	  contains keys that the `INFOPLIST_KEY_*` build-setting mechanism
	  cannot express — i.e., arrays of dictionaries and arrays of strings.
	  Xcode still auto-populates the boilerplate keys (CFBundleExecutable,
	  CFBundleIdentifier, CFBundleShortVersionString, etc.) and merges
	  the remaining simple `INFOPLIST_KEY_*` entries (usage descriptions,
	  UIApplicationSupportsIndirectInputEvents, etc.) from the build
	  settings during `ProcessInfoPlistFile`.

	  Keep this file minimal — only add keys here that genuinely cannot
	  be expressed via `INFOPLIST_KEY_*`. Simple string/bool keys should
	  stay in `scripts/generate_xcode_project.rb`.
	-->

	<!-- volumearc:// deep links for widget taps, Siri shortcut fallback,
	     and universal-link-style navigation from push notifications. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.mabryventures.VolumeArc</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>volumearc</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
		</dict>
	</array>

	<!-- Background task identifiers that `VolumeArcBackgroundTasks`
	     registers and submits. Missing from this allowlist → iOS rejects
	     `BGTaskScheduler.submit(...)` with "Unpermitted task identifier"
	     and background refresh/sync silently never runs. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.mabryventures.VolumeArc.appRefresh</string>
		<string>com.mabryventures.VolumeArc.appProcessing</string>
	</array>

	<!-- Background modes required to schedule the BGTasks above. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>

	<!-- HealthKit privacy copy kept here so static plist checks can
	     verify the authorization path even before build-setting
	     `INFOPLIST_KEY_*` values are merged by Xcode. -->
	<key>NSHealthShareUsageDescription</key>
	<string>VolumeArc reads your completed workouts, heart-rate variability, sleep, Workout Effort, wrist temperature, and respiratory rate from Apple Health to show your training history, calculate readiness, and let the AI coach reference your recovery trend.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>VolumeArc writes completed workouts so your training history stays in sync with Apple Health.</string>

	<!-- VOL-126: App Store Connect validation requires either an explicit
	     launch screen or UIRequiresFullScreen=YES. Empty UILaunchScreen
	     dict is the modern SwiftUI default — iOS renders a generic
	     splash that matches the app's window background while the first
	     scene loads. No storyboard/xib needed. -->
	<key>UILaunchScreen</key>
	<dict/>

	<!-- VOL-126 / VOL-131: App Store Connect validation requires interface
	     orientations to be declared. v1 is iPhone-only
	     (`TARGETED_DEVICE_FAMILY = 1` in the generated project), and the
	     SwiftUI hierarchy is designed around portrait lifting flows. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!--
	  Runtime configuration injected from environment variables at archive
	  time. The build settings `SENTRY_DSN` / `VOLUMEARC_AI_RELAY_URL`
	  default to empty in `scripts/generate_xcode_project.rb`; Xcode Cloud
	  workflows override them via Environment Variables panel
	  (`SENTRY_DSN`, `VOLUMEARC_AI_RELAY_URL`). `ProcessInfoPlistFile`
	  substitutes the build setting into the bundle plist at archive time,
	  so the running app's `Bundle.main.object(forInfoDictionaryKey:)`
	  reads the actual configured value.

	  Empty string for either key is treated as "not configured" by
	  `VolumeArcSentryConfiguration.resolveDSN()` /
	  `VolumeArcAIConfiguration.relayConfiguration` — the app degrades to
	  the no-Sentry / local-heuristic-coach paths and surfaces a
	  startup warning so the gap is visible in the diagnostics view.
	-->
	<key>VolumeArcSentryDSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>VolumeArcAIRelayURL</key>
	<string>$(VOLUMEARC_AI_RELAY_URL)</string>
	</dict>
</plist>
