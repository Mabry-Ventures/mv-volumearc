# macOS
.DS_Store

# Xcode build artifacts
build/
Build/
.build/
DerivedData/
xcuserdata/
*.xcuserstate
*.xcarchive

# xcodebuild-generated workspace data (Package.resolved, etc.)
# The project is Ruby-generated, so this directory is rebuilt by xcodebuild on every run.
VolumeArcApple.xcodeproj/project.xcworkspace/

# VOL-90: the canonical SPM lockfile lives at repo root, not inside the
# gitignored workspace dir. Keep it tracked — CI seeds the workspace
# copy from it (see `.github/workflows/ci.yml` + `scripts/generate_xcode_project.rb`)
# so every dev + CI resolves to the same Sentry pin.
!/Package.resolved

# Signing & credentials
*.mobileprovision
*.p8
*.p12
*.cer
*.xcconfig

# Environment & secrets
.env
.env.*
Secrets/

# Dependencies
Pods/
Carthage/
vendor/bundle/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# Claude Code local session state
.claude/

# Marketing site (Next.js) build artifacts
# marketing/ has its own .gitignore for the bulk; these are belt-and-suspenders.
marketing/.next/
marketing/.vercel/
marketing/node_modules/
marketing/coverage/
marketing/.turbo/
marketing/next-env.d.ts
