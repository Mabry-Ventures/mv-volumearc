# macOS
.DS_Store

# Xcode build artifacts
build/
Build/
.build/
DerivedData/
xcuserdata/
*.xcuserstate
*.xcarchive

# xcodebuild-generated workspace data — ignore everything in xcworkspace
# EXCEPT the SPM lockfile that Xcode Cloud requires to be committed (see
# below). The project is Ruby-generated, so the rest of this dir
# (contents.xcworkspacedata, xcuserdata, IDEWorkspaceChecks.plist) is
# rebuilt by xcodebuild on every run and shouldn't be tracked.
#
# The canonical "ignore dir but keep one file" pattern requires explicit
# un-ignore at every parent level, hence the staircase.
VolumeArcApple.xcodeproj/project.xcworkspace/*
!VolumeArcApple.xcodeproj/project.xcworkspace/xcshareddata
VolumeArcApple.xcodeproj/project.xcworkspace/xcshareddata/*
!VolumeArcApple.xcodeproj/project.xcworkspace/xcshareddata/swiftpm
VolumeArcApple.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*

# VOL-90: the canonical SPM lockfile lives at repo root, not inside the
# gitignored workspace dir. Keep it tracked — CI seeds the workspace
# copy from it (see `.github/workflows/ci.yml` + `scripts/generate_xcode_project.rb`)
# so every dev + CI resolves to the same Sentry pin.
!/Package.resolved

# VOL-126: Xcode Cloud requires the workspace-scoped Package.resolved to be
# committed when SPM auto-resolution is disabled (Apple's CI default).
# Without this, the archive job fails at xcodebuild -resolvePackageDependencies
# with: "a resolved file is required when automatic dependency resolution is
# disabled". The generator keeps this in sync with the root Package.resolved
# on every regen.
!VolumeArcApple.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# Signing & credentials
*.mobileprovision
*.p8
*.p12
*.cer
*.xcconfig

# Environment & secrets
.env
.env.*
Secrets/

# Dependencies
Pods/
Carthage/
vendor/bundle/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# Claude Code local session state
.claude/

# Python bytecode caches from helper scripts (e.g.
# scripts/_compute_coverage_summary.py imported during local testing).
__pycache__/
*.pyc

# Lefthook (VOL-152): per-developer hook overrides. The committed
# lefthook.yml is the team standard; lefthook-local.yml is gitignored
# so a contributor can disable or add personal hooks without touching
# the shared config.
lefthook-local.yml

# Toolchain (VOL-151): `.ruby-version` is the single source of truth.
# `mise.local.toml` is mise's per-developer override file — gitignored
# so a contributor's local pin (e.g. for Bundler or another tool) doesn't
# leak into the repo. `mise.toml` itself is intentionally not in the repo
# (see docs/CONTRIBUTING.md "Dev setup") so it can't shadow `.ruby-version`;
# adding it here keeps an accidental `mise use --pin` from sneaking it in.
mise.toml
mise.local.toml

# Marketing site (Next.js) build artifacts
# marketing/ has its own .gitignore for the bulk; these are belt-and-suspenders.
marketing/.next/
marketing/.vercel/
marketing/node_modules/
marketing/coverage/
marketing/.turbo/
marketing/next-env.d.ts

# VOL-219: Cloudflare Wrangler state directory at the repo root.
# `relay/.gitignore` already ignores `.wrangler/` inside `relay/`, but
# a stray `wrangler` invocation from the repo root (or a tool that
# uses Wrangler's library mode) drops `.wrangler/` here too. The
# 2026-05-18 audit caught `?? .wrangler/` in `git status` against a
# clean working tree.
.wrangler/
