<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		VolumeArcWatch (com.mabryventures.VolumeArc.watchkitapp) privacy
		manifest. VOL-73.

		Scope notes:
		- Microphone / SpeechRecognizer: NOT used on watchOS (voice
		  coaching is phone-only). No audio data collection here.
		- Location: not used anywhere in VolumeArc.
		- HealthKit: HKWorkoutSession / HKLiveWorkoutBuilder are
		  watchOS-specific per HealthStore.swift. Watch target carries
		  NSHealthShareUsageDescription / NSHealthUpdateUsageDescription
		  and will request access as the workout UI wires up.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
			UserDefaults: UserDefaultsWatchSessionStateStore,
			UserDefaultsWatchPendingPayloadStore, and the shared app-group
			snapshot reader. App functionality only.
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!--
			HealthKit data on watchOS: workout sessions, heart rate,
			active energy. Same rationale as the iOS target — app
			functionality, not linked to identity, not tracking.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeHealthAndFitness</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
