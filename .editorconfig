# VOL-218: EditorConfig — normalize whitespace + line endings across
# every editor a contributor might use. The CI release-validation gate
# (`scripts/validate_release_config.sh`) and the determinism gate
# (`scripts/generate_xcode_project.rb` regen check) both rely on the
# committed tree being byte-stable; differences in trailing whitespace
# or final-newline policy can flip the determinism check and waste a
# CI cycle. Keeping this file at the repo root means VS Code, JetBrains,
# Vim, Sublime, and most editors pick it up without per-editor config.

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Swift uses 4-space indent (default above).

[*.{rb,yml,yaml,json,toml}]
indent_size = 2

[*.{ts,tsx,js,jsx,mjs}]
indent_size = 2

[Makefile]
indent_style = tab

# Markdown: trailing whitespace at end-of-line is sometimes
# significant (two trailing spaces = soft break). Don't trim.
[*.md]
trim_trailing_whitespace = false
