# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-5
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_MODEL_TRANSCRIBE=gpt-4o-mini-transcribe
OPENAI_MODEL_EMBED=text-embedding-3-small

# Optional per-route feature flags (defaults to enabled)
AI_ENABLE_WORKOUT_PLAN=true
AI_ENABLE_LIVE_COACH=true
AI_ENABLE_POST_WORKOUT=true
AI_ENABLE_RISK_ANALYSIS=true
AI_ENABLE_LOG_PARSER=true
AI_ENABLE_TRANSCRIBE=true
AI_ENABLE_PROGRESSION_PLAN=true

# Optional client-visible flags for settings display
NEXT_PUBLIC_AI_ENABLE_WORKOUT_PLAN=true
NEXT_PUBLIC_AI_ENABLE_LIVE_COACH=true
NEXT_PUBLIC_AI_ENABLE_POST_WORKOUT=true
NEXT_PUBLIC_AI_ENABLE_RISK_ANALYSIS=true
NEXT_PUBLIC_AI_ENABLE_LOG_PARSER=true
NEXT_PUBLIC_AI_ENABLE_TRANSCRIBE=true
NEXT_PUBLIC_AI_ENABLE_PROGRESSION_PLAN=true

# Rate limiting (recommended for production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth + Sync
AUTH_SECRET=
NEXTAUTH_SECRET=
DATABASE_URL=
BEAST_MODE_ALPHA_AUTH_PASSWORD=

# Progressive rollout flags (non-AI)
FEATURE_TELEMETRY_INGEST=true
FEATURE_CLOUD_SYNC_ALPHA=false
FEATURE_PROGRESSION_AUTOPILOT=true
FEATURE_RETENTION_LOOPS=true
FEATURE_HEALTH_INTEGRATIONS=false
FEATURE_MONETIZATION_CONTROLS=true

# Optional telemetry export (for external observability pipelines)
TELEMETRY_EXPORT_URL=
TELEMETRY_EXPORT_TOKEN=
TELEMETRY_EXPORT_MIN_INTERVAL_MS=30000

# Optional wearable connector overrides
OURA_API_BASE_URL=https://api.oura.com/v2/usercollection

# Entitlement + cost controls
BEAST_MODE_TIER=free
BEAST_MODE_DAILY_AI_BUDGET_USD=2
BEAST_MODE_MONTHLY_AI_BUDGET_USD=30
