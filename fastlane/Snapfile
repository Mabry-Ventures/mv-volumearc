# App Store screenshot matrix for VolumeArc.
#
# Generated by `fastlane ios screenshots` (called from the release lane).
# Output lives in fastlane/screenshots/ and is picked up automatically by
# `deliver` during `fastlane ios release`.
#
# Screenshot capture is implemented in `VolumeArcScreenshotTests` with
# the local `SnapshotHelper.swift` wrapper.

# Device matrix — keep this in sync with VOL-96 and App Store marketing
# requirements. iPhone 17 covers the 6.3" class; iPhone 17 Pro Max covers
# the 6.9" class; Apple Watch Series 11 covers the watchOS listing.
devices([
  "iPhone 17",
  "iPhone 17 Pro Max",
  "Apple Watch Series 11 (46mm)"
])

# Localizations — add new App Store locales here. Each locale must have a
# matching XCUITest flow that calls `snapshot("name")` after launching in
# that language.
languages([
  "en-US"
])

# Release screenshots render the submitted subscription prices from a
# Debug-only deterministic fixture. The simulator StoreKit daemon can return
# an empty product list even when the local `.storekit` catalog is attached,
# which makes screenshot generation flaky without changing production StoreKit
# behavior.
launch_arguments(["-UseScreenshotStoreKitFixtures", "1"])

# Scheme used for screenshot capture.
scheme("VolumeArcAppUITests")

# Output location — `deliver` reads from here by default, so the release
# lane doesn't need to pass a path override.
output_directory("fastlane/screenshots")

# Wipe previous screenshots before each run so we don't ship stale assets.
clear_previous_screenshots(true)

# Fail fast on the first simulator error — catching problems early is
# cheaper than waiting for the full matrix to churn.
stop_after_first_error(true)

# Run simulators in parallel where the runner has the cores for it.
concurrent_simulators(true)
