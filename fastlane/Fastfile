default_platform(:ios)

before_all do
  sh("ruby", "../scripts/generate_xcode_project.rb")
end

platform :ios do
  desc "Run tests on iPhone 17 simulator"
  lane :test do
    run_tests(
      project: "VolumeArcApple.xcodeproj",
      scheme: "VolumeArcAppTests",
      device: "iPhone 17",
      code_coverage: true,
      output_types: "junit",
      output_directory: "build/test-results"
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    version = File.read("../VERSION").strip
    build_number = sh("git rev-list --count HEAD").strip

    increment_version_number(
      version_number: version,
      xcodeproj: "VolumeArcApple.xcodeproj"
    )
    increment_build_number(
      build_number: build_number,
      xcodeproj: "VolumeArcApple.xcodeproj"
    )

    build_app(
      project: "VolumeArcApple.xcodeproj",
      scheme: "VolumeArcApp",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/export",
      output_name: "VolumeArc.ipa",
      include_symbols: true,
      include_bitcode: false
    )

    # VOL-92: validate signed entitlements on the archived bundle before
    # uploading. gym populates Actions.lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    # — the archive's Products/Applications/*.app is the canonical signed
    # bundle, so point the validator at it via the VOLUMEARC_BUILT_APP_PATH
    # override. If gym didn't record an archive (edge case), the validator
    # falls back to its DerivedData discovery logic. Fails the lane before
    # upload if aps-environment drifted to development, the iCloud container
    # identifier vanished, HealthKit was stripped, or the App Group
    # disappeared in signing.
    archive_path = Actions.lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    if archive_path && File.directory?(archive_path)
      built_app = Dir.glob(File.join(archive_path, "Products/Applications/*.app")).first
      built_watch = Dir.glob(File.join(archive_path, "Products/Applications/*.app/Watch/*.app")).first
      ENV["VOLUMEARC_BUILT_APP_PATH"] = built_app if built_app
      ENV["VOLUMEARC_BUILT_WATCH_PATH"] = built_watch if built_watch
    end
    sh("../scripts/validate_release_config.sh")

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    )
  end

  desc "Submit to App Store review"
  lane :release do
    beta

    deliver(
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    )
  end
end
