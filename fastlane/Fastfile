require "fileutils"
require "json"
require "shellwords"
require "time"
require "tmpdir"

opt_out_usage

default_platform(:ios)

before_all do
  sh("ruby", "../scripts/generate_xcode_project.rb")
end

# VOL-150: tester-facing What-To-Test note for `upload_to_testflight`.
# Returns a bulleted summary of commit subjects between the previous
# `v*` tag and HEAD. Caps the body at 3800 chars (Apple's 4000 ceiling
# minus headroom for any footer ASC adds) with a `...` truncation
# suffix. Falls back to a generic message when no prior tag exists
# (first TestFlight build of a fresh checkout) or when the git
# command fails for any reason.
#
# Why per-commit (not per-merged-PR via gh API): squash-merged PRs
# already land as one commit each, so `git log --pretty=format` gives
# the same granularity as a `gh pr list --state merged` query without
# the GitHub API round-trip + auth dependency. The trade-off: the
# subject line is whatever was in the squash commit message rather
# than the PR title, but the repo's PR-template convention keeps
# those aligned in practice.
def build_what_to_test_note(max_chars: 3800)
  default_note = "Internal TestFlight build. See the PR list at " \
    "https://github.com/Mabry-Ventures/mv-volumearc/pulls?q=is%3Apr+is%3Amerged+sort%3Aupdated-desc " \
    "for change details."

  previous_tag = begin
    raw = sh("git", "describe", "--tags", "--abbrev=0", "--match", "v*", "HEAD^", log: false).strip
    raw.empty? ? nil : raw
  rescue StandardError
    nil
  end

  range = previous_tag ? "#{previous_tag}..HEAD" : "HEAD"
  commits_raw = begin
    sh("git", "log", "--pretty=format:- %s", range, log: false).strip
  rescue StandardError
    ""
  end

  if commits_raw.empty?
    return default_note
  end

  bullets = commits_raw.lines.map(&:rstrip).reject(&:empty?).uniq
  if bullets.empty?
    return default_note
  end

  header = previous_tag ? "What's new since #{previous_tag}:" : "What's new in this build:"
  body = ([header] + bullets).join("\n")

  if body.length > max_chars
    # Truncate on a line boundary so the bullet that crosses the
    # ceiling isn't left half-rendered in the tester UI.
    trimmed = body[0, max_chars - 4]
    last_newline = trimmed.rindex("\n") || trimmed.length
    body = trimmed[0, last_newline] + "\n..."
  end

  body
end

def volume_arc_app_store_connect_api_key
  key_id = ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip
  key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"].to_s.strip

  missing = []
  missing << "APP_STORE_CONNECT_KEY_ID" if key_id.empty?
  missing << "APP_STORE_CONNECT_ISSUER_ID" if issuer_id.empty?
  missing << "APP_STORE_CONNECT_API_KEY_PATH" if key_path.empty?
  unless missing.empty?
    UI.user_error!("App Store Connect API key env missing: #{missing.join(', ')}")
  end

  expanded_key_path = File.expand_path(key_path)
  unless File.file?(expanded_key_path)
    UI.user_error!("APP_STORE_CONNECT_API_KEY_PATH does not point to a readable .p8 file.")
  end

  mode = File.stat(expanded_key_path).mode & 0o777
  if (mode & 0o077) != 0
    UI.user_error!(
      "APP_STORE_CONNECT_API_KEY_PATH must be owner-only (chmod 600). " \
        "Refusing to use a group/world-readable ASC key."
    )
  end

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: expanded_key_path,
    duration: 1200,
    in_house: false
  )
end

def volume_arc_xcodebuild_auth_args
  key_id = ENV["APP_STORE_CONNECT_KEY_ID"].to_s.strip
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip
  key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"].to_s.strip

  return [] if key_id.empty? || issuer_id.empty? || key_path.empty?

  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath #{Shellwords.escape(File.expand_path(key_path))}",
    "-authenticationKeyID #{Shellwords.escape(key_id)}",
    "-authenticationKeyIssuerID #{Shellwords.escape(issuer_id)}"
  ]
end

def volume_arc_generate_sentry_framework_dsym(archive_path)
  sentry_binary = File.join(
    archive_path,
    "Products/Applications/VolumeArc.app/Frameworks/Sentry.framework/Sentry"
  )
  unless File.file?(sentry_binary)
    UI.user_error!("VOL-133: bundled Sentry.framework binary missing at #{sentry_binary}")
  end

  sentry_dsym = File.join(archive_path, "dSYMs/Sentry.framework.dSYM")
  FileUtils.rm_rf(sentry_dsym)
  sh("xcrun", "dsymutil", sentry_binary, "-o", sentry_dsym)

  binary_uuid = sh("xcrun", "dwarfdump", "--uuid", sentry_binary, log: false)
    .lines
    .first
    .to_s
    .split[1]
  dsym_uuid = sh("xcrun", "dwarfdump", "--uuid", sentry_dsym, log: false)
    .lines
    .first
    .to_s
    .split[1]
  if binary_uuid.to_s.empty? || binary_uuid != dsym_uuid
    UI.user_error!(
      "VOL-133: generated Sentry.framework dSYM UUID mismatch " \
        "(binary=#{binary_uuid || '<empty>'}, dSYM=#{dsym_uuid || '<empty>'})."
    )
  end

  UI.message("VOL-133: generated archived Sentry.framework dSYM (#{binary_uuid})")
  sentry_dsym
end

def volume_arc_write_dsym_manifest(dsym_dir, manifest_path)
  debug_files = Dir.glob(File.join(dsym_dir, "*.dSYM", "Contents/Resources/DWARF", "*"))
    .sort
    .flat_map do |debug_file|
      sh("xcrun", "dwarfdump", "--uuid", debug_file, log: false)
        .lines
        .map do |line|
          match = line.chomp.match(/\AUUID:\s+([A-F0-9-]+)\s+\(([^)]+)\)\s+(.+)\z/i)
          next unless match

          {
            uuid: match[1].downcase,
            arch: match[2],
            binary: File.basename(match[3]),
            path: debug_file
          }
        end
        .compact
    end

  File.write(
    manifest_path,
    JSON.pretty_generate(
      generated_at: Time.now.utc.iso8601,
      debug_file_count: debug_files.length,
      debug_files: debug_files
    )
  )
end

platform :ios do
  desc "Run tests on iPhone 17 simulator"
  lane :test do
    run_tests(
      project: "VolumeArcApple.xcodeproj",
      scheme: "VolumeArcAppTests",
      device: "iPhone 17",
      code_coverage: true,
      output_types: "junit",
      output_directory: "build/test-results"
    )
  end

  desc "Build and upload to TestFlight (local archive fallback; CI uses Xcode Cloud)"
  # VOL-126: as of 2026-05-04, CI tag deploys go through Xcode Cloud
  # (Apple-managed signing) — see `ci_scripts/ci_post_xcodebuild.sh`
  # and `docs/RELEASE.md` for the canonical path. This lane is kept
  # for local archive fallback: a developer with an admin Apple
  # Developer login + signing cert in their keychain can run
  # `bundle exec fastlane ios beta` to archive + sign + upload from
  # their Mac. It still emits `build_number=<N>` to GITHUB_OUTPUT
  # when invoked from a GitHub Actions context.
  #
  # Waits for App Store Connect processing (up to 30 minutes) so tag
  # builds fail loudly when processing is rejected instead of silently
  # succeeding with a rejected upload.
  lane :beta do
    version = File.read("../VERSION").strip
    build_number = sh("git rev-list --count HEAD").strip
    asc_api_key = volume_arc_app_store_connect_api_key
    sentry_dsn = ENV["SENTRY_DSN"].to_s.strip
    sentry_dsn = ENV["VOLUMEARC_SENTRY_DSN"].to_s.strip if sentry_dsn.empty?
    if sentry_dsn.empty?
      UI.user_error!(
        "SENTRY_DSN or VOLUMEARC_SENTRY_DSN must be set before TestFlight upload. " \
          "Refusing to ship a build without crash reporting."
      )
    elsif sentry_dsn.include?("$(") || sentry_dsn !~ %r{\Ahttps://[^/@]+@[^/]+/.+}
      UI.user_error!(
        "SENTRY_DSN or VOLUMEARC_SENTRY_DSN must be a configured HTTPS Sentry DSN URL with public key, " \
          "not a placeholder or malformed value."
      )
    end
    ENV["SENTRY_DSN"] = sentry_dsn
    relay_url = ENV["VOLUMEARC_AI_RELAY_URL"].to_s.strip
    if relay_url.empty?
      UI.user_error!(
        "VOLUMEARC_AI_RELAY_URL must be set before TestFlight upload. " \
          "Refusing to ship a build without the production AI relay."
      )
    elsif relay_url != "https://relay.volumearc.app"
      UI.user_error!(
        "VOLUMEARC_AI_RELAY_URL must be https://relay.volumearc.app for TestFlight upload, " \
          "got #{relay_url.inspect}."
      )
    end
    ENV["VOLUMEARC_AI_RELAY_URL"] = relay_url
    # `SENTRY_DSN` is declared as an empty generated Xcode build setting so
    # `$(SENTRY_DSN)` resolves cleanly in local/dev builds. A plain shell env
    # var does not override that target setting during Info.plist processing, so
    # the release lane injects runtime config through a temporary xcconfig. The
    # `https:/$()/` form avoids xcconfig's `//` comment parsing while still
    # resolving to `https://` in the processed build setting.
    relay_xcconfig_url = relay_url.sub(%r{\Ahttps://}, "https:/$()/")
    sentry_xcconfig_dsn = sentry_dsn.sub(%r{\Ahttps://}, "https:/$()/")
    sentry_xcconfig_path = File.join(Dir.tmpdir, "volumearc-sentry-#{Process.pid}.xcconfig")
    File.write(
      sentry_xcconfig_path,
      "SENTRY_DSN = #{sentry_xcconfig_dsn}\n" \
        "VOLUMEARC_AI_RELAY_URL = #{relay_xcconfig_url}\n"
    )
    FileUtils.chmod(0o600, sentry_xcconfig_path)

    increment_version_number(
      version_number: version,
      xcodeproj: "VolumeArcApple.xcodeproj"
    )
    increment_build_number(
      build_number: build_number,
      xcodeproj: "VolumeArcApple.xcodeproj"
    )

    # VOL-126: the project generator sets `CODE_SIGNING_ALLOWED = NO`
    # globally so unit/UI tests can build without a signing cert
    # available. The beta lane needs the inverse — flip it back on for
    # the archive/export, and pass `team_id:` so the export step
    # records a team in the .xcarchive's Info.plist (otherwise
    # `xcodebuild -exportArchive` fails with "No Team Found in Archive"
    # before sentry-cli or upload_to_testflight even runs). The
    # `DEVELOPMENT_TEAM` env var comes from the GitHub Actions secret
    # of the same name in the deploy-testflight job.
    xcodebuild_auth_args = volume_arc_xcodebuild_auth_args
    archive_xcargs = (
      [
        "CODE_SIGNING_ALLOWED=YES",
        "DEVELOPMENT_TEAM=#{Shellwords.escape(ENV.fetch("DEVELOPMENT_TEAM"))}",
        "-xcconfig #{Shellwords.escape(sentry_xcconfig_path)}"
      ] + xcodebuild_auth_args
    ).join(" ")

    begin
      build_app(
        project: "VolumeArcApple.xcodeproj",
        scheme: "VolumeArcApp",
        configuration: "Release",
        export_method: "app-store",
        export_team_id: ENV.fetch("DEVELOPMENT_TEAM"),
        output_directory: "build/export",
        output_name: "VolumeArc.ipa",
        include_symbols: true,
        include_bitcode: false,
        xcargs: archive_xcargs
      )
    ensure
      FileUtils.rm_f(sentry_xcconfig_path)
    end

    # VOL-92: validate the final exported IPA before uploading. With local
    # automatic signing, the intermediate .xcarchive may be development-signed
    # and then re-signed during `xcodebuild -exportArchive`; the IPA is the
    # artifact that reaches TestFlight, so it is the canonical release contract.
    archive_path = Actions.lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    ipa_path = Actions.lane_context[SharedValues::IPA_OUTPUT_PATH]
    if ipa_path.to_s.empty? || !File.file?(ipa_path)
      UI.user_error!("VOL-92: cannot validate exported IPA — no IPA_OUTPUT_PATH from gym.")
    end
    sh("../scripts/validate_release_config.sh", "--no-build")
    sh("../scripts/validate_exported_ipa_contract.sh", ipa_path, build_number)

    # VOL-133: upload dSYMs to Sentry so production crash reports
    # symbolicate. Without this step, every crash that lands in Sentry
    # arrives as obfuscated frames and root-cause analysis is blocked.
    #
    # Hard-fails when SENTRY_AUTH_TOKEN is unset or sentry-cli errors so
    # a silent upload failure can't reach App Store Connect with missing
    # crash telemetry or unsymbolicated dSYMs.
    if ENV["SENTRY_AUTH_TOKEN"].to_s.empty?
      UI.user_error!(
        "SENTRY_AUTH_TOKEN must be set before TestFlight upload. " \
          "Refusing to ship a build without Sentry dSYM upload."
      )
    elsif archive_path.nil? || !File.directory?(archive_path)
      UI.user_error!("VOL-133: cannot upload dSYMs — no .xcarchive recorded by gym.")
    else
      dsym_dir = File.join(archive_path, "dSYMs")
      unless File.directory?(dsym_dir) && !Dir.empty?(dsym_dir)
        UI.user_error!("VOL-133: dSYM directory missing or empty at #{dsym_dir}.")
      end
      volume_arc_generate_sentry_framework_dsym(archive_path)

      sentry_org = ENV.fetch("SENTRY_ORG", "mabry-ventures-llc")
      sentry_project = ENV.fetch("SENTRY_PROJECT", "volumearc-ios")
      manifest_path = File.expand_path("../build/sentry-dsym-manifest.json", __dir__)
      FileUtils.mkdir_p(File.dirname(manifest_path))

      UI.message("VOL-133: uploading dSYMs from #{dsym_dir} → #{sentry_org}/#{sentry_project}")
      sh(
        "sentry-cli", "debug-files", "upload",
        "--org", sentry_org,
        "--project", sentry_project,
        "--include-sources",
        "--wait",
        "--log-level=info",
        dsym_dir
      )

      # Capture the uploaded UUID inventory as a local artifact for
      # traceability. sentry-cli 3.x removed the old server-side
      # `debug-files list` command, so derive the manifest from the exact
      # dSYMs we just uploaded.
      volume_arc_write_dsym_manifest(dsym_dir, manifest_path)
      UI.success("VOL-133: dSYMs uploaded; manifest at #{manifest_path}")
    end

    # VOL-150: build the What-To-Test note from the merged-PR titles
    # since the previous tag. `pilot` accepts a `changelog:` parameter
    # that surfaces verbatim in the TestFlight tester UI under "What
    # to Test." Without this, testers see a generic build with no
    # guidance on what changed or what to focus on. Source: every
    # commit subject between the previous `v*` tag and HEAD, formatted
    # as a bulleted list. Squash-merged PRs land as one commit each so
    # the list is per-PR rather than per-fixup.
    what_to_test = build_what_to_test_note
    UI.message("VOL-150: What-To-Test note (#{what_to_test.length} chars):")
    UI.message(what_to_test)

    # VOL-96: wait for App Store Connect build processing instead of
    # fire-and-forget. We previously returned success the moment the
    # upload completed, even if ASC rejected the build during processing
    # (which happens 2-15 minutes later). Now we block up to 30 minutes
    # and translate ITMS validation errors into a human-readable fail.
    begin
      upload_to_testflight(
        skip_waiting_for_build_processing: false,
        wait_processing_interval: 30,
        # 30 minute ceiling for App Store Connect processing. If processing
        # exceeds this window we fail loudly rather than silently succeed.
        wait_processing_timeout_duration: 1800,
        api_key: asc_api_key,
        # VOL-150: tester-facing release notes for this TestFlight
        # build. `changelog:` is the documented `pilot` parameter for
        # the What-To-Test field. Apple caps the body at 4000 chars;
        # `build_what_to_test_note` enforces a 3800-char ceiling with
        # a `...` suffix so there's headroom for any footer ASC adds.
        changelog: what_to_test
      )
    rescue => e
      message = e.message.to_s
      clean_reason =
        if message.include?("Invalid") || message.match?(/ITMS-\d+/)
          # App Store Connect returns ITMS-xxxxx codes for validation errors.
          itms = message[/ITMS-\d+[^\n]*/]
          itms ? "App Store Connect rejected processing: #{itms}" : message
        elsif message.downcase.include?("timeout") || message.downcase.include?("timed out")
          "App Store Connect processing exceeded the 30-minute timeout. " \
            "Check https://appstoreconnect.apple.com for the build status."
        else
          "App Store Connect processing failed: #{message.lines.first&.strip || message}"
        end
      UI.user_error!(clean_reason)
    end

    # Capture the freshly processed build number and expose it to GitHub
    # Actions so downstream jobs (release notes, Slack notify, changelog)
    # can reference it without re-querying App Store Connect.
    latest_build = lane_context[SharedValues::LATEST_TESTFLIGHT_BUILD_NUMBER]
    if latest_build && ENV["GITHUB_OUTPUT"] && !ENV["GITHUB_OUTPUT"].empty?
      File.open(ENV["GITHUB_OUTPUT"], "a") do |f|
        f.puts("build_number=#{latest_build}")
      end
      UI.success("Emitted build_number=#{latest_build} to GITHUB_OUTPUT")
    elsif latest_build
      UI.message("Latest TestFlight build number: #{latest_build}")
    else
      UI.important(
        "Upload succeeded but LATEST_TESTFLIGHT_BUILD_NUMBER was not set; " \
          "skipping GITHUB_OUTPUT emission."
      )
    end
  end

  desc "Generate App Store screenshots via snapshot"
  # Runs `snapshot` against the device matrix declared in fastlane/Snapfile
  # (see that file for devices/locales). Screenshots are written to
  # fastlane/screenshots/ and picked up automatically by `deliver`.
  #
  # Screenshot capture lives in `VolumeArcScreenshotTests` and uses the
  # local `SnapshotHelper.swift` wrapper so fastlane can collect named
  # XCTest attachments from the xcresult bundle. Do not add screenshot
  # generation to the beta lane — only release.
  lane :screenshots do
    ENV["VOLUMEARC_RUN_SCREENSHOT_CAPTURE"] = "1"
    helper_path = File.expand_path(
      "../Tests/VolumeArcAppUITests/SnapshotHelper.swift",
      __dir__
    )
    unless File.exist?(helper_path)
      UI.user_error!(
        "SnapshotHelper.swift is missing from Tests/VolumeArcAppUITests/. " \
          "Screenshot capture helper is missing; restore SnapshotHelper.swift " \
          "and VolumeArcScreenshotTests before running fastlane screenshots."
      )
    end

    capture_ios_screenshots(
      project: "VolumeArcApple.xcodeproj",
      scheme: "VolumeArcAppUITests",
      output_directory: "fastlane/screenshots",
      clear_previous_screenshots: true,
      concurrent_simulators: true,
      stop_after_first_error: true
    )
  end

  desc "Roll back the public TestFlight group to a prior processed build (VOL-178)"
  # Operator workflow: a SEV1/SEV2 incident requires reinstating the prior
  # build for external testers. Apple has no "App Store recall" API, but
  # TestFlight build assignment is reversible.
  #
  # Inputs (positional or build:/reason:/severity:):
  #   build:    the build_number to roll back TO (the known-good prior build).
  #   reason:   a one-sentence description recorded in docs/incident-log.md.
  #   severity: SEV1 | SEV2 | SEV3 | SEV4 (default SEV2).
  #
  # What the lane DOES today:
  #   1. Validates inputs (build numeric, reason present, severity valid).
  #   2. Reads VERSION + ASC API credentials from env.
  #   3. Confirms via App Store Connect (`latest_testflight_build_number`)
  #      that the target build is NOT already the latest — i.e. we're
  #      actually rolling backward, not sideways.
  #   4. Prints the canonical operator walk-through for the TestFlight
  #      public-group swap.
  #   5. Appends a structured entry to docs/incident-log.md.
  #
  # What the lane does NOT do (yet):
  #   - Automated swap of the public TestFlight build. Spaceship can drive
  #     this via BetaGroup updates, but the failure mode of getting it
  #     wrong (sending an OLDER bad build wide) is bad enough that v1.0
  #     keeps a manual confirm-in-UI step. Once we've run a real rollback
  #     drill the lane can become one-step.
  #   - App Store (production) recall — there's no API for it; the lane
  #     prints the "expedited review" walk-through for prod incidents.
  #
  # Usage:
  #   bundle exec fastlane ios rollback \
  #     build:142 \
  #     reason:"SEV2: paywall crash on iOS 26.4" \
  #     severity:SEV2
  lane :rollback do |options|
    target_build_number = options[:build].to_s.strip
    if target_build_number.empty? || !target_build_number.match?(/\A\d+\z/)
      UI.user_error!("VOL-178: build:<N> required and must be numeric (the build_number to roll back TO)")
    end

    reason = options[:reason].to_s.strip
    if reason.empty?
      UI.user_error!("VOL-178: reason:\"<one sentence>\" required (recorded in docs/incident-log.md)")
    end

    severity = options[:severity].to_s.strip.upcase
    severity = "SEV2" if severity.empty?
    unless %w[SEV1 SEV2 SEV3 SEV4].include?(severity)
      UI.user_error!("VOL-178: severity must be one of SEV1, SEV2, SEV3, SEV4 (default SEV2)")
    end

    asc_api_key = volume_arc_app_store_connect_api_key

    version = File.read("../VERSION").strip
    UI.message("VOL-178: rolling back TestFlight to build #{target_build_number} of v#{version}")
    UI.message("VOL-178: reason: #{reason}")
    UI.message("VOL-178: severity: #{severity}")

    # Sanity-check via spaceship — `latest_testflight_build_number` returns
    # the latest processed build for this version. If the target equals
    # latest, the operator is rolling sideways, not back; abort with a
    # clear error rather than letting them paste a no-op walk-through.
    UI.message("VOL-178: verifying target build state in App Store Connect (best-effort)...")
    bundle_id = ENV.fetch("VOLUMEARC_BUNDLE_ID", "com.mabryventures.VolumeArc")

    begin
      latest = latest_testflight_build_number(
        version: version,
        app_identifier: bundle_id,
        api_key: asc_api_key
      )
      UI.message("VOL-178: latest processed TestFlight build for v#{version}: #{latest}")

      if latest.to_s == target_build_number
        UI.user_error!(
          "VOL-178: target build #{target_build_number} is ALREADY the latest. " \
            "Did you mean to roll back to an OLDER build? Check ASC and pass " \
            "the correct prior build number."
        )
      end
    rescue FastlaneCore::Interface::FastlaneError
      raise
    rescue => e
      UI.important(
        "VOL-178: could not confirm build state via fastlane API " \
          "(continuing with the manual operator walk-through). " \
          "Underlying error: #{e.message.lines.first&.strip}"
      )
    end

    # ---- Operator walk-through ---------------------------------------------
    walk_through = <<~STEPS

      ====================================================================
      VOL-178 TestFlight rollback — operator confirmation required
      --------------------------------------------------------------------
      App:           VolumeArc (#{bundle_id})
      Version:       #{version}
      Target build:  #{target_build_number}
      Severity:      #{severity}
      Reason:        #{reason}
      --------------------------------------------------------------------
      Steps:

      1. Open https://appstoreconnect.apple.com/apps/<APP-ID>/testflight/ios
      2. Click "External Testers" → "VolumeArc Testers" (or your default
         public group).
      3. Click "Builds" tab.
      4. Verify build #{target_build_number} is present and processed.
         If not present, you need to re-upload the prior build via
         `bundle exec fastlane ios beta` at the prior tag — STOP HERE
         and coordinate with on-call.
      5. Add build #{target_build_number} to the group. The current build
         is automatically demoted to "available to internal only" for the
         public group.
      6. (Optional) Add a tester-facing message: "Investigating issue —
         please install build #{target_build_number}."
      7. Confirm at https://appstoreconnect.apple.com/.../testflight that
         the public group now shows build #{target_build_number}.
      8. File a #{severity} postmortem ticket in Linear using
         docs/INCIDENTS.md → "Post-incident → postmortem template".

      For PROD App Store (live release) recall:
        There is no API for App Store recall. File an "Expedited review
        request" at https://developer.apple.com/contact/app-store/?topic=expedite
        and submit a hotfix build via `bundle exec fastlane ios release`
        pointing at the rollback target. See docs/INCIDENTS.md SEV1
        runbook for the full sequence.
      ====================================================================

    STEPS
    UI.message(walk_through)

    # ---- Operator confirmation (Codex P2 on PR #167) -----------------------
    # Don't log a successful rollback unless the operator confirms they've
    # actually completed the swap in ASC. Skipping this would let the lane
    # silently record a "success" event when the operator stopped midway
    # (e.g., target build wasn't available, network dropped, second
    # thoughts about the rollback). Honor `VOLUMEARC_ROLLBACK_NONINTERACTIVE`
    # for CI / drill runs where prompting isn't possible.
    if ENV["VOLUMEARC_ROLLBACK_NONINTERACTIVE"].to_s == "1"
      UI.important("VOL-178: VOLUMEARC_ROLLBACK_NONINTERACTIVE=1 — skipping confirmation prompt (CI/drill mode).")
    else
      confirmed = UI.confirm(
        "VOL-178: did you finish the ASC swap to build #{target_build_number}? (y = log success / n = abort)"
      )
      unless confirmed
        UI.user_error!(
          "VOL-178: operator did not confirm the swap. Incident log NOT written, " \
            "GITHUB_OUTPUT NOT emitted. Re-run the lane after completing the ASC " \
            "swap, or coordinate with on-call."
        )
      end
    end

    # ---- Incident log append -----------------------------------------------
    incident_log_path = File.expand_path("../docs/incident-log.md", __dir__)
    timestamp = Time.now.utc.strftime("%Y-%m-%d %H:%M UTC")
    entry = <<~ENTRY

      ## #{timestamp} — TestFlight rollback v#{version} build → #{target_build_number} (#{severity})

      - **Reason:** #{reason}
      - **Rolled back to build:** #{target_build_number}
      - **Operator:** #{ENV.fetch('USER', 'unknown')}
      - **Triggered via:** `fastlane ios rollback build:#{target_build_number} reason:"#{reason}" severity:#{severity}`
      - **Postmortem:** _to be filed in Linear; link here once created_
    ENTRY

    unless File.exist?(incident_log_path)
      UI.user_error!(
        "VOL-178: docs/incident-log.md missing. Bootstrap it with the " \
          "template at the top of docs/INCIDENTS.md."
      )
    end

    File.open(incident_log_path, "a") { |f| f.write(entry) }
    UI.success("VOL-178: appended rollback entry to docs/incident-log.md")

    if ENV["GITHUB_OUTPUT"] && !ENV["GITHUB_OUTPUT"].empty?
      File.open(ENV["GITHUB_OUTPUT"], "a") do |f|
        f.puts("rollback_target_build=#{target_build_number}")
        f.puts("rollback_severity=#{severity}")
      end
    end
  end

  desc "Submit an already-UAT'd TestFlight build to App Store review"
  # TestFlight candidate creation and physical UAT are separate from App
  # Store submission. By default this lane assumes the candidate build is
  # already processed, selected in App Store Connect, and recorded in
  # docs/RELEASE_UAT_EVIDENCE.md. Passing upload_beta:true creates a fresh
  # TestFlight candidate and then stops before submission so evidence cannot
  # be accidentally reused for the wrong build.
  lane :release do |options|
    upload_beta = options[:upload_beta].to_s == "true" || ENV["VOLUMEARC_RELEASE_UPLOAD_BETA"] == "1"
    if upload_beta
      beta
      UI.user_error!(
        "TestFlight candidate uploaded and processed. Complete physical UAT evidence for that exact build, " \
          "then rerun `bundle exec fastlane ios release` without upload_beta:true to submit it."
      )
    end

    release_candidate_sha = options[:candidate_sha].to_s.strip
    release_candidate_sha = ENV["VOLUMEARC_RELEASE_CANDIDATE_SHA"].to_s.strip if release_candidate_sha.empty?
    if release_candidate_sha.empty?
      UI.user_error!(
        "VOLUMEARC_RELEASE_CANDIDATE_SHA or candidate_sha:<sha> is required. " \
          "It must match the Commit SHA in docs/RELEASE_UAT_EVIDENCE.md for the already-UAT'd TestFlight build."
      )
    end

    begin
      previous_release_ready = ENV["VOLUMEARC_RELEASE_READY"]
      previous_candidate_sha = ENV["VOLUMEARC_RELEASE_CANDIDATE_SHA"]
      ENV["VOLUMEARC_RELEASE_READY"] = "1"
      ENV["VOLUMEARC_RELEASE_CANDIDATE_SHA"] = release_candidate_sha
      sh("../scripts/validate_release_config.sh", "--no-build")
    ensure
      if previous_release_ready.nil?
        ENV.delete("VOLUMEARC_RELEASE_READY")
      else
        ENV["VOLUMEARC_RELEASE_READY"] = previous_release_ready
      end
      if previous_candidate_sha.nil?
        ENV.delete("VOLUMEARC_RELEASE_CANDIDATE_SHA")
      else
        ENV["VOLUMEARC_RELEASE_CANDIDATE_SHA"] = previous_candidate_sha
      end
    end
    # PR #363 review (Codex P1): pin the review submission to the exact
    # build the UAT evidence covers. Without an explicit build_number,
    # deliver auto-selects the latest processed TestFlight build for the
    # version — a build uploaded after UAT evidence was recorded would be
    # submitted unverified. Parsed before the screenshot pass so a missing
    # or malformed manifest fails fast instead of after a full snapshot run.
    evidence = File.read(File.expand_path("../docs/RELEASE_UAT_EVIDENCE.md", __dir__))
    uat_build_number = evidence[/^\|\s*TestFlight build\s*\|\s*(\d+)\s*\|/, 1]
    uat_app_version = evidence[/^\|\s*App version\s*\|\s*([0-9][0-9.]*)\s*\|/, 1]
    if uat_build_number.to_s.empty? || uat_app_version.to_s.empty?
      UI.user_error!(
        "docs/RELEASE_UAT_EVIDENCE.md must record numeric 'TestFlight build' and 'App version' " \
          "rows so the review submission is pinned to the UAT'd build."
      )
    end

    screenshots

    deliver(
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_screenshots: false,
      screenshots_path: "fastlane/screenshots",
      app_version: uat_app_version,
      build_number: uat_build_number,
      api_key: volume_arc_app_store_connect_api_key
    )
  end
end
